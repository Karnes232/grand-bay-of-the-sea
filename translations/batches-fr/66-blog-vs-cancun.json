  "d542f09b-61a8-481a-b2ef-3f604f99c9b4::blogBody::7666b21c8cce": "Choisissez <g id=\"1\">Punta Cana</g> si vous recherchez :",
  "d542f09b-61a8-481a-b2ef-3f604f99c9b4::blogBody::af8d108cf4c3": "La détente",

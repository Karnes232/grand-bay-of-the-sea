  "d542f09b-61a8-481a-b2ef-3f604f99c9b4::blogBody::fa35f6dcaf19": "Ambiance festive",
  "d542f09b-61a8-481a-b2ef-3f604f99c9b4::blogBody::7e73432f8a4d": "Soirées jusque tard dans la nuit",
  "d542f09b-61a8-481a-b2ef-3f604f99c9b4::blogBody::5500aba2edc1": "<g id=\"0\">Punta Cana :</g>",
  "d542f09b-61a8-481a-b2ef-3f604f99c9b4::blogBody::065cb7de6452": "Vie nocturne dans les hôtels",
  "d542f09b-61a8-481a-b2ef-3f604f99c9b4::blogBody::f9d8c60d041b": "Plus détendue",

  "d542f09b-61a8-481a-b2ef-3f604f99c9b4::blogBody::9dd8f8cfb714": "Plus de sollicitations commerciales",
  "d542f09b-61a8-481a-b2ef-3f604f99c9b4::blogBody::336019d408e7": "👉 <g id=\"1\">Gagnant : Punta Cana</g>",
  "d542f09b-61a8-481a-b2ef-3f604f99c9b4::blogBody::9e539c13013d": "😌 Ambiance générale : détente ou fête",
  "d542f09b-61a8-481a-b2ef-3f604f99c9b4::blogBody::16a044e4cce5": "C'est là que se trouve la plus grande différence.",
  "d542f09b-61a8-481a-b2ef-3f604f99c9b4::blogBody::b846afc0c572": "<g id=\"0\">Punta Cana :</g>",
  "d542f09b-61a8-481a-b2ef-3f604f99c9b4::blogBody::b5d2c90b193a": "Détendue",

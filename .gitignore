# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

/graphify-out

# typescript
*.tsbuildinfo
next-env.d.ts

# Local deliverables — audits, reports, crawler output. Generated for the owner,
# large, dated, and regenerated often; none of it is part of the app.
#
# No PDF at the repo root belongs to the app, so ignore the lot rather than
# naming each report family as they appear. Anchored to the root: PDFs under
# public/ or src/ are still tracked.
/*.pdf
*-AUDIT-SUMMARY*.md
GEO-AUDIT-REPORT*.md
GEO-PROGRESS-REPORT*.md
GEO-REPORT*.html

# Crawler output. Both rules are needed: `*-audit/` catches
# www.grandbay-puntacana.com-audit/, `*-audit-*/` the dated
# www.grandbay-puntacana.com-audit-2026-07-25/.
*-audit/
*-audit-*/

# Translation exchange files. The exported XLIFF/CSV are derived from Sanity
# and regenerable (`npm run i18n:export`), so they stay out. The batch files
# under translations/batches-<locale>/ are the opposite: hand-authored
# translations that cannot be regenerated, so they ARE versioned.
/translations/*
!/translations/batches-*/

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

/graphify-out

# typescript
*.tsbuildinfo
next-env.d.ts

# GEO audit deliverables (kept local, not part of the app)
GEO-AUDIT-REPORT*.md
GEO-PROGRESS-REPORT*.md
GEO-REPORT*.pdf
GEO-REPORT*.html
*-audit/

# Translation exchange files. The exported XLIFF/CSV are derived from Sanity
# and regenerable (`npm run i18n:export`), so they stay out. The batch files
# under translations/batches/ are the opposite: hand-authored German that
# cannot be regenerated, so they ARE versioned.
/translations/*
!/translations/batches/
